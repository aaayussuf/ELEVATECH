# ELEVATECH — local development (copy to .env, never commit real secrets)
SECRET_KEY=dev-secret-key-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
# DATABASE_URL=postgresql://user:password@localhost:5432/elevatech
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Local testing: returns OTP in register/resend JSON so you can verify without SMS
EXPOSE_DEV_OTP=true
AUTO_INIT_DB=true

# ---------- Email (Gmail) — OPTIONAL for local dev ----------
# Without these, registration still works: the code is printed in the
# backend terminal and (with EXPOSE_DEV_OTP=true) returned in the API
# response. To send REAL emails via Gmail, fill these in and RESTART
# the backend:
# 1. Turn ON 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create a 16-letter App Password: https://myaccount.google.com/apppasswords
#    (App name: e.g. "ELEVATECH"). Use THAT as MAIL_PASSWORD — NOT your
#    normal Gmail password (Gmail rejects normal passwords with
#    "Username and Password not accepted").
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=youremail@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_DEFAULT_SENDER=youremail@gmail.com

# ---------- Image uploads (Cloudinary) — OPTIONAL for local dev ----------
# If these 3 are blank/missing, product images are saved to backend/uploads/
# and served at http://127.0.0.1:5000/uploads/... — no setup needed.
# To use Cloudinary instead, fill these in (Dashboard > Settings) and RESTART
# the backend:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Optional: custom local folder (default: uploads)
# UPLOAD_FOLDER=uploads
